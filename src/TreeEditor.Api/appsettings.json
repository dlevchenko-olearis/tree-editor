{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "MaxRequestBodyBytes": 8388608,
    "MutationPermitLimit": 60,
    "MutationWindowSeconds": 60,
    "TransientRetryAfterSeconds": 1
  }
}
